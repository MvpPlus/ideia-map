# Local: mock. Vercel preview/prod: supabase (defina também NEXT_PUBLIC_DATA_SOURCE).
DATA_SOURCE=mock
NEXT_PUBLIC_DATA_SOURCE=mock

# Supabase — publishable no cliente; secret só servidor (nunca NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy até depreciação Supabase (2026): NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# URL pública do deploy (reset de senha Supabase)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# IA — só servidor (.env.local / Vercel env)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GOOGLE_AI_STUDIO_API_KEY=

# Busca na web (opcional)
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=
